# Copy this file to .env.local and fill in. Both values are public by design (row-level security
# is the boundary); the service-role key must never appear in this file or in src/.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional. Features switched off for this build, comma-separated: labs, liveFeed, errorReports, pageSpeed.
# Leave empty to keep everything on (see src/lib/flags.ts and docs/RUNBOOK.md, Rollback).
VITE_DISABLED_FEATURES=
